# SkyGuard environment configuration — copy to ".env" and fill in.
#
#   cp .env.example .env
#   chmod 600 .env          # keep secrets readable only by you
#
# The .env file is loaded automatically by scripts/start_web_portal.py and is
# gitignored, so nothing here is ever committed. Any value set here overrides
# the corresponding field in config/skyguard.yaml.

# ---------------------------------------------------------------------------
# Web portal authentication (required to log in)
# ---------------------------------------------------------------------------
# Username for the portal login (default: admin)
SKYGUARD_WEB_USERNAME=admin

# Portal login password. Set this before first start. If left unset, a random
# one-time password is generated and printed to the console / logs/web.log on
# every startup.
SKYGUARD_WEB_PASSWORD=change-me-to-a-strong-passphrase

# Optional: supply a pre-computed werkzeug password hash instead of the
# plaintext above (takes precedence if set). Generate one with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('yourpassword'))"
# SKYGUARD_WEB_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Session signing key
# ---------------------------------------------------------------------------
# Optional. If unset, a persistent random key is generated and stored at
# data/.flask_secret (gitignored) so sessions survive restarts. Set this only
# if you want to share one key across multiple hosts. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SKYGUARD_SECRET_KEY=

# ---------------------------------------------------------------------------
# Notification secrets (optional — only needed for the channels you enable)
# ---------------------------------------------------------------------------
# These override the matching fields in config/skyguard.yaml, so you can keep
# credentials out of the (previously git-tracked) YAML file entirely.

# Email (SMTP) password
# SKYGUARD_EMAIL_PASSWORD=

# Twilio SMS
# SKYGUARD_SMS_ACCOUNT_SID=
# SKYGUARD_SMS_AUTH_TOKEN=

# Pushbullet
# SKYGUARD_PUSH_API_KEY=

# Discord webhook URL
# SKYGUARD_DISCORD_WEBHOOK=
